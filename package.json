{
  "name": "edji-optimus",
  "version": "1.1.40",
  "description": "Node backend for Edji.",
  "scripts": {
    "build": "webpack",
    "start:webpack": "pm2-runtime start ecosystem.config.js",
    "start": "nodemon -L --exec node --inspect=9229 -r ts-node/register src",
    "start:local": "yarn mongo && MONGO_HOST='mongodb://localhost:27017/edji' yarn start",
    "test": "mocha -r ts-node/register -r dotenv/config 'src/**/*.spec.*' --timeout 4000 --exit",
    "test:ci": "touch .env && yarn test --reporter mocha-junit-reporter --reporter-options mochaFile=./test-results/mocha/results.xml",
    "bump": "npm run bump:patch",
    "bump:patch": "yarn version --new-version patch",
    "bump:minor": "yarn version --new-version minor",
    "bump:major": "yarn version --new-version major",
    "mongo": "mongod --config mongod.conf"
  },
  "repository": {
    "type": "git",
    "url": "github.com/codiak/edji-optimus"
  },
  "author": "Edji",
  "private": true,
  "engines": {
    "node": "^10.15",
    "yarn": "^1.13"
  },
  "dependencies": {
    "@sentry/node": "4.2.3",
    "aws-sdk": "^2.548.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.2",
    "crypto-js": "^3.1.9-1",
    "dotenv": "^5.0.0",
    "elasticsearch": "^15.3.0",
    "express": "^4.16.3",
    "forever": "^0.15.3",
    "googleapis": "37.0.0",
    "hashids": "^1.1.0",
    "joi": "^14.3.1",
    "jsonwebtoken": "^8.5.0",
    "mailchimp-api-v3": "^1.7.0",
    "method-override": "^2.3.10",
    "mongoose": "^5.4.19",
    "ms": "^2.1.1",
    "nodemailer": "^2.6.4",
    "on-headers": "^1.0.2",
    "pm2": "^4.1.2",
    "q": "^1.4.1",
    "randomstring": "^1.1.5",
    "request": "^2.88.0",
    "request-promise-native": "^1.0.5",
    "simple-oauth2": "^2.2.1",
    "stripe": "^7.9.1",
    "typescript": "^2.8.3",
    "underscore": "^1.8.3",
    "uuid": "^3.3.2"
  },
  "devDependencies": {
    "@types/aws-sdk": "^2.7.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/chai": "^4.1.6",
    "@types/chai-http": "^3.0.5",
    "@types/crypto-js": "^3.1.43",
    "@types/dotenv": "^6.1.1",
    "@types/elasticsearch": "^5.0.30",
    "@types/express": "^4.16.0",
    "@types/joi": "^14.3.1",
    "@types/jsonwebtoken": "^8.3.2",
    "@types/mocha": "^5.2.5",
    "@types/mongodb": "^3.1.14",
    "@types/mongoose": "^5.5.28",
    "@types/ms": "^0.7.30",
    "@types/node": "^11.11.3",
    "@types/on-headers": "^1.0.0",
    "@types/proxyquire": "^1.3.28",
    "@types/randomstring": "^1.1.6",
    "@types/request-promise": "^4.1.41",
    "@types/request-promise-native": "^1.0.15",
    "@types/simple-oauth2": "^2.2.1",
    "@types/sinon": "^7.0.10",
    "@types/sinon-chai": "^3.2.2",
    "@types/stripe": "^6.32.8",
    "@types/underscore": "^1.8.9",
    "@types/uuid": "^3.4.4",
    "@typescript-eslint/eslint-plugin": "^1.5.0",
    "@typescript-eslint/parser": "^1.5.0",
    "chai": "^4.0.0",
    "chai-as-promised": "^7.1.1",
    "chai-http": "^4.2.0",
    "edji-types": "git+http://git@github.com/codiak/edji-types.git#1.0.2",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-prettier": "^3.0.1",
    "mocha": "^5.2.0",
    "mocha-junit-reporter": "^1.18.0",
    "node-mocks-http": "^1.5.8",
    "nodemon": "^1.11.0",
    "prettier": "^1.16.4",
    "proxyquire": "^2.1.0",
    "sinon": "^7.2.7",
    "sinon-as-promised": "^4.0.3",
    "sinon-chai": "^3.3.0",
    "sinon-mongoose": "^2.1.1",
    "ts-loader": "^5.3.3",
    "ts-mock-imports": "^1.2.3",
    "ts-node": "^7.0.1",
    "webpack": "^4.29.6",
    "webpack-cli": "^3.3.0",
    "webpack-node-externals": "^1.7.2"
  }
}
