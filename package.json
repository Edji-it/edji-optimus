{
  "name": "edji-server",
  "version": "1.1.3",
  "description": "Node backend for Edji.",
  "scripts": {
    "start": "nodemon -L --exec yarn serve:dev",
    "start:local": "yarn mongo && MONGO_HOST='mongodb://localhost:27017/edji' yarn start",
    "test": "yarn build:dev && mocha 'build/src/**/*.spec.js' --timeout 4000 --exit",
    "test:ci": "yarn build:prod && mocha 'build/src/**/*.spec.js' --timeout 4000 --exit",
    "bump": "npm run bump:patch",
    "serve:dev": "yarn build:dev && node ./build/src",
    "serve:prod": "yarn build:prod && forever ./build/src",
    "bump:patch": "yarn version --new-version patch",
    "bump:minor": "yarn version --new-version minor",
    "bump:major": "yarn version --new-version major",
    "build:dev": "rm -rf build && tsc && cp .env build",
    "build:prod": "rm -rf build && tsc",
    "mongo": "mongod --config mongod.conf"
  },
  "repository": {
    "type": "git",
    "url": "github.com/codiak/edji-server"
  },
  "author": "Edji",
  "private": true,
  "license": "",
  "engines": {
    "node": "^8.9.4"
  },
  "dependencies": {
    "@sentry/node": "4.2.3",
    "bcryptjs": "^2.3.0",
    "body-parser": "^1.18.2",
    "crypto-js": "^3.1.9-1",
    "dotenv": "^5.0.0",
    "express": "^4.16.3",
    "forever": "^0.15.3",
    "hashids": "^1.1.0",
    "joi": "^13.1.2",
    "jsonwebtoken": "^5.7.0",
    "mailchimp-api-v3": "^1.7.0",
    "method-override": "^2.3.10",
    "mongoose": "^5.2.14",
    "mongoose-simple-random": "^0.3.3",
    "ms": "^2.1.1",
    "nodemailer": "^2.6.4",
    "nodemailer-mandrill-transport": "^1.2.0",
    "passport": "^0.3.2",
    "passport-google-oauth20": "^1.0.0",
    "q": "^1.4.1",
    "querystring": "^0.2.0",
    "request": "^2.79.0",
    "request-promise": "^4.2.1",
    "require": "^2.4.20",
    "response-time": "^2.3.2",
    "socket.io": "^1.4.8",
    "stripe": "^4.23.1",
    "typescript": "^2.8.3",
    "underscore": "^1.8.3",
    "uuid": "^3.0.1"
  },
  "devDependencies": {
    "@types/chai": "^4.1.6",
    "@types/chai-http": "^3.0.5",
    "@types/crypto-js": "^3.1.43",
    "@types/express": "^4.16.0",
    "@types/mocha": "^5.2.5",
    "@types/mongodb": "^3.1.14",
    "@types/mongoose": "^5.3.1",
    "@types/proxyquire": "^1.3.28",
    "@types/request-promise": "^4.1.41",
    "@types/sinon": "^5.0.2",
    "chai": "^4.0.0",
    "chai-as-promised": "^7.1.1",
    "chai-http": "^4.2.0",
    "mocha": "^5.2.0",
    "node-mocks-http": "^1.5.8",
    "nodemon": "^1.11.0",
    "randomstring": "^1.1.5",
    "sinon": "^7.1.1",
    "sinon-as-promised": "^4.0.3",
    "sinon-mongoose": "^2.1.1",
    "ts-node": "^7.0.1"
  }
}