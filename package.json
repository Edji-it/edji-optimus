{
  "name": "edji-server",
  "version": "1.1.3",
  "description": "Node backend for Edji.",
  "scripts": {
    "start": "node ./index.js",
    "dev": "NODE_ENV=local nodemon ./index.js localhost 3354",
    "test": "NODE_ENV=test mocha --timeout 4000",
    "test:dev": "NODE_ENV=dev mocha --timeout 4000",
    "test:projects": "NODE_ENV=test mocha --timeout 4000 --grep Projects",
    "test:readings": "NODE_ENV=test mocha --timeout 4000 --grep Readings",
    "test:users": "NODE_ENV=test mocha --timeout 4000 --grep Users",
    "test:tempusers": "NODE_ENV=test mocha --timeout 4000 --grep TempUsers",
    "test:subscriptions": "NODE_ENV=test mocha --timeout 4000 --grep Subscriptions",
    "bump": "npm run bump:patch",
    "bump:patch": "yarn version --new-version patch",
    "bump:minor": "yarn version --new-version minor",
    "bump:major": "yarn version --new-version major"
  },
  "repository": {
    "type": "git",
    "url": "github.com/codiak/edji-server"
  },
  "author": "Edji",
  "license": "",
  "engines": {
    "node": "^8.1.0"
  },
  "dependencies": {
    "bcryptjs": "^2.3.0",
    "body-parser": "^1.15.0",
    "config": "^1.24.0",
    "crypto": "0.0.3",
    "express": "^4.13.4",
    "express-session": "^1.15.3",
    "forever": "^0.15.1",
    "hashids": "^1.1.0",
    "jsonwebtoken": "^5.7.0",
    "mailchimp-api-v3": "^1.7.0",
    "mongoose": "4.7.6",
    "mongoose-simple-random": "^0.3.3",
    "nodemailer": "^2.6.4",
    "nodemailer-mandrill-transport": "^1.2.0",
    "passport": "^0.3.2",
    "passport-google-oauth20": "^1.0.0",
    "q": "^1.4.1",
    "querystring": "^0.2.0",
    "request": "^2.79.0",
    "request-promise": "^4.2.1",
    "require": "^2.4.20",
    "response-time": "^2.3.2",
    "restify": "^4.0.4",
    "socket.io": "^1.4.8",
    "stripe": "^4.23.1",
    "underscore": "^1.8.3",
    "uuid": "^3.0.1"
  },
  "devDependencies": {
    "chai": "^4.0.0",
    "chai-http": "^3.0.0",
    "nodemon": "^1.11.0",
    "randomstring": "^1.1.5",
    "sinon": "^1.17.6"
  }
}
